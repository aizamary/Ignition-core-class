{
  "custom": {},
  "params": {
    "LineNumber": 1
  },
  "propConfig": {
    "params.LineNumber": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 150,
      "width": 300
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "classes": "TagLabels"
          },
          "text": "Amps"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "LedDisplay"
        },
        "position": {
          "basis": 120,
          "grow": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "LineNumber": "{view.params.LineNumber}"
                },
                "tagPath": "[default]Motor/Line {LineNumber}/Amps"
              },
              "type": "tag"
            }
          }
        },
        "type": "ia.display.led-display"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center"
    },
    "type": "ia.container.flex"
  }
}